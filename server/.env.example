# =========================================================================
# JIGME ENTERPRISE BACKEND - PRODUCTION VPS ENVIRONMENT CONFIGURATION (.env)
# =========================================================================
# Server Execution Mode
NODE_ENV=production
PORT=5000

# 1. PostgreSQL Database Connection (from aaPanel Database Section)
# Format: postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME
DATABASE_URL=postgresql://jigme_admin:YourSecureDbPassword@127.0.0.1:5432/jigme_enterprise

# 2. Cryptographic Token Secrets (Generate using: openssl rand -base64 48)
JWT_SECRET=generate_strong_48_char_secret_here
JWT_REFRESH_SECRET=generate_strong_48_char_refresh_secret_here
IP_HASH_SALT=generate_strong_32_char_salt_here

# 3. CORS Allowed Origins (Comma-separated public and staff domains)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://api.yourdomain.com

# 4. Initial Seed Credentials (Used when running 'npm run seed' on VPS)
SEED_ADMIN_PASSWORD=SetAStrongSuperAdminPassword2026!
SEED_BROKER_PASSWORD=SetAStrongBrokerPassword2026!
SEED_AGENT_PASSWORD=SetAStrongAgentPassword2026!

# 5. SMTP Email Configuration (For real password reset and lead dispatch)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=YourSmtpPassword
EMAIL_FROM="Jigme Real Estate <noreply@yourdomain.com>"

# 6. Optional AI Integration Key (For Tashi AI & Content Generation)
AI_API_KEY=your_gemini_or_openai_api_key
